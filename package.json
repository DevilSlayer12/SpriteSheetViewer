{
  "name": "spritesheetviewer",
  "private": true,
  "description": "Animate any 2D sprite sheet in the browser",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --minify --target=es2020 --outfile=js/app.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=js/app.js --watch"
  },
  "devDependencies": { "esbuild": "^0.24.0" }
}
